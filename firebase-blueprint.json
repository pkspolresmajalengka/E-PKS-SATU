{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "Kontingen peserta lomba PBB PKS beserta rincian nilai 11 kriteria",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier peserta",
          "maxLength": 128
        },
        "nomor": {
          "type": "string",
          "description": "Nomor urut peserta",
          "maxLength": 20
        },
        "peleton": {
          "type": "string",
          "description": "Nama peleton peserta",
          "maxLength": 100
        },
        "jenjang": {
          "type": "string",
          "description": "Jenjang pendidikan (SLTP atau SLTA)",
          "enum": ["SLTP", "SLTA"]
        },
        "sekolah": {
          "type": "string",
          "description": "Nama asal sekolah",
          "maxLength": 150
        },
        "tanggal": {
          "type": "string",
          "description": "Tanggal pelaksanaan",
          "maxLength": 50
        },
        "juri": {
          "type": "string",
          "description": "Nama juri penilai",
          "maxLength": 100
        },
        "scores": {
          "type": "object",
          "description": "Objek nilai untuk 11 kriteria penilaian"
        },
        "notes": {
          "type": "string",
          "description": "Catatan juri untuk peserta",
          "maxLength": 1000
        },
        "sheetPhotoUrl": {
          "type": "string",
          "description": "Foto/scan lembar penilaian juri"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu terakhir pembaruan data"
        }
      },
      "required": ["id", "nomor", "peleton", "jenjang", "sekolah"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Akun pengguna sistem (Admin, Juri, dan Perwakilan Sekolah)",
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "description": "Username unik untuk login",
          "maxLength": 100
        },
        "password": {
          "type": "string",
          "description": "Password login",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "description": "Nama lengkap pengguna atau nama sekolah",
          "maxLength": 150
        },
        "role": {
          "type": "string",
          "description": "Peran akun dalam sistem",
          "enum": ["superadmin", "admin", "juri", "sekolah", "pembina_polres", "user"]
        },
        "schoolName": {
          "type": "string",
          "description": "Nama sekolah jika peran sekolah",
          "maxLength": 150
        },
        "schoolLevel": {
          "type": "string",
          "description": "Jenjang sekolah jika peran sekolah",
          "enum": ["SLTP", "SLTA"]
        },
        "pembinaName": {
          "type": "string",
          "description": "Nama guru pembina pendamping",
          "maxLength": 150
        },
        "contactWa": {
          "type": "string",
          "description": "Nomor WhatsApp pembina",
          "maxLength": 30
        },
        "isCustom": {
          "type": "boolean",
          "description": "Penanda akun tambahan mandiri"
        },
        "schoolProfile": {
          "type": "object",
          "description": "Data profil lengkap pangkalan sekolah (NPSN, status sekolah, alamat, kecamatan, kabupaten, kode pos, kepala sekolah, NIP, email sekolah, telepon sekolah, motto, dan logo sekolah)"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan"
        }
      },
      "required": ["username", "name", "role"]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Konfigurasi kriteria, bobot, dan teknis penilaian",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier config",
          "maxLength": 50
        },
        "categories": {
          "type": "object",
          "description": "Data kategori dan bobot penilaian"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu update konfigurasi"
        }
      },
      "required": ["id"]
    },
    "AppLogo": {
      "title": "AppLogo",
      "description": "Pengaturan logo institusi / perlombaan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier logo",
          "maxLength": 50
        },
        "logoUrl": {
          "type": "string",
          "description": "URL atau Base64 gambar logo"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu update logo"
        }
      },
      "required": ["id"]
    },
    "AppStatus": {
      "title": "AppStatus",
      "description": "Status aktif/nonaktif aplikasi beserta pesan penonaktifan kustom yang hanya dapat dikelola admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier status",
          "maxLength": 50
        },
        "isActive": {
          "type": "boolean",
          "description": "Status operasional aplikasi: true (aktif) atau false (nonaktif/maintenance)"
        },
        "title": {
          "type": "string",
          "description": "Judul kustom pengumuman penonaktifan aplikasi",
          "maxLength": 200
        },
        "message": {
          "type": "string",
          "description": "Isi pesan kustom pengumuman penonaktifan aplikasi",
          "maxLength": 2000
        },
        "estimateTime": {
          "type": "string",
          "description": "Estimasi waktu aktif kembali atau jadwal buka",
          "maxLength": 100
        },
        "contactInfo": {
          "type": "string",
          "description": "Informasi narahubung panitia/administrator",
          "maxLength": 100
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan status"
        },
        "updatedBy": {
          "type": "string",
          "description": "Username admin yang melakukan perubahan",
          "maxLength": 100
        }
      },
      "required": ["id", "isActive", "title", "message"]
    },
    "RegistrationSubmission": {
      "title": "RegistrationSubmission",
      "description": "Pengajuan berkas 4 formulir pendaftaran PKS resmi beserta NIPP Polisi Pelajar dan pelacakan pembayaran Cash/Cicilan",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID pengajuan formulir",
          "maxLength": 128
        },
        "formType": {
          "type": "string",
          "description": "Jenis formulir pendaftaran",
          "enum": ["polisi_pelajar", "calon_pks", "kemah_balok1", "pks_balok2"]
        },
        "schoolName": {
          "type": "string",
          "description": "Nama asal sekolah",
          "maxLength": 150
        },
        "studentName": {
          "type": "string",
          "description": "Nama siswa / pendaftar",
          "maxLength": 150
        },
        "submissionDate": {
          "type": "string",
          "description": "Tanggal pendaftaran",
          "maxLength": 50
        },
        "nomorIndukPoljar": {
          "type": "string",
          "description": "Nomor Induk Polisi Pelajar (PP-YYYY-AA-DDMMYYYY)",
          "maxLength": 64
        },
        "nippStatus": {
          "type": "string",
          "description": "Status keaktifan NIPP Polisi Pelajar",
          "enum": ["pending_payment", "active"]
        },
        "tahunAngkatan": {
          "type": "string",
          "description": "Tahun angkatan yang diatur Admin",
          "maxLength": 10
        },
        "angkatan": {
          "type": "string",
          "description": "Nomor angkatan yang diatur Admin",
          "maxLength": 10
        },
        "paymentPlan": {
          "type": "string",
          "description": "Skema pembayaran pendaftaran",
          "enum": ["cash", "installment"]
        },
        "paymentStatus": {
          "type": "string",
          "description": "Status pembayaran pendaftaran",
          "enum": ["unpaid", "partial", "pending_verification", "paid", "rejected"]
        },
        "feeAmount": {
          "type": "number",
          "description": "Total biaya pendaftaran"
        },
        "paidAmount": {
          "type": "number",
          "description": "Nominal total yang sudah terbayar dan terverifikasi"
        },
        "remainingAmount": {
          "type": "number",
          "description": "Sisa tagihan pembayaran"
        },
        "installmentHistory": {
          "type": "array",
          "description": "Riwayat pembayaran DP / cicilan / pelunasan"
        },
        "data": {
          "type": "object",
          "description": "Rincian isi formulir pendaftaran"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pengajuan"
        }
      },
      "required": ["id", "formType", "schoolName"]
    },
    "CerdasCermatConfig": {
      "title": "CerdasCermatConfig",
      "description": "Pengaturan paket soal dan status buka/tutup Lomba Cerdas Cermat yang dikelola Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Identifier dokumen konfigurasi (cerdas_cermat_config)",
          "maxLength": 64
        },
        "title": {
          "type": "string",
          "description": "Judul paket soal Lomba Cerdas Cermat",
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "description": "Petunjuk pengerjaan soal untuk akun sekolah",
          "maxLength": 2000
        },
        "isOpen": {
          "type": "boolean",
          "description": "Menentukan apakah formulir soal terbuka untuk dijawab oleh sekolah"
        },
        "questions": {
          "type": "array",
          "description": "Daftar butir soal pilihan ganda dan isian/esai beserta bobot poin dan kunci jawaban"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu terakhir paket soal diperbarui"
        },
        "updatedBy": {
          "type": "string",
          "description": "Username admin yang memperbarui paket soal",
          "maxLength": 100
        }
      },
      "required": ["id", "title", "isOpen"]
    },
    "CerdasCermatSubmission": {
      "title": "CerdasCermatSubmission",
      "description": "Kiriman jawaban Lomba Cerdas Cermat dari akun sekolah beserta hasil penilaian Admin",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "ID kiriman deterministik berbasis username sekolah (cc_<username>)",
          "maxLength": 128
        },
        "schoolUsername": {
          "type": "string",
          "description": "Username akun sekolah pengirim jawaban",
          "maxLength": 100
        },
        "schoolName": {
          "type": "string",
          "description": "Nama resmi pangkalan sekolah",
          "maxLength": 150
        },
        "schoolLevel": {
          "type": "string",
          "description": "Jenjang pendidikan sekolah",
          "enum": ["SLTP", "SLTA"]
        },
        "submittedByName": {
          "type": "string",
          "description": "Nama perwakilan pengirim pada akun sekolah",
          "maxLength": 150
        },
        "participantId": {
          "type": "string",
          "description": "ID peserta lomba tujuan sinkronisasi nilai di Rekap Utama",
          "maxLength": 128
        },
        "participantLabel": {
          "type": "string",
          "description": "Label peserta tujuan sinkronisasi",
          "maxLength": 200
        },
        "answers": {
          "type": "object",
          "description": "Peta jawaban sekolah per ID soal (pilihan ganda & isian/esai)"
        },
        "questionGrades": {
          "type": "object",
          "description": "Peta nilai per butir soal dan catatan koreksi dari Admin"
        },
        "autoMcScore": {
          "type": "number",
          "description": "Total skor butir pilihan ganda"
        },
        "essayScore": {
          "type": "number",
          "description": "Total skor butir isian/esai"
        },
        "totalScore": {
          "type": "number",
          "description": "Skor akhir resmi Lomba Cerdas Cermat"
        },
        "maxPossibleScore": {
          "type": "number",
          "description": "Total poin maksimal dari soal yang dikerjakan"
        },
        "status": {
          "type": "string",
          "description": "Status penilaian kiriman sekolah",
          "enum": ["submitted", "graded"]
        },
        "adminNote": {
          "type": "string",
          "description": "Catatan koreksi keseluruhan dari Admin",
          "maxLength": 1000
        },
        "gradedBy": {
          "type": "string",
          "description": "Nama atau username admin penilai",
          "maxLength": 150
        },
        "gradedAt": {
          "type": "string",
          "description": "Waktu pengesahan nilai oleh Admin"
        },
        "submittedAt": {
          "type": "string",
          "description": "Waktu pengiriman jawaban oleh sekolah"
        },
        "updatedAt": {
          "type": "string",
          "description": "Waktu pembaruan terakhir"
        }
      },
      "required": ["id", "schoolUsername", "schoolName", "schoolLevel", "status"]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": {
        "$ref": "#/entities/Participant"
      },
      "description": "Koleksi data peserta dan penilaian rekapitulasi lomba"
    },
    "/users/{username}": {
      "schema": {
        "$ref": "#/entities/UserAccount"
      },
      "description": "Koleksi akun pengguna sistem"
    },
    "/config/{configId}": {
      "schema": {
        "$ref": "#/entities/AppConfig"
      },
      "description": "Konfigurasi kriteria penilaian dan bobot juknis"
    },
    "/settings/{settingId}": {
      "schema": {
        "$ref": "#/entities/AppLogo"
      },
      "description": "Pengaturan aplikasi global (global_logo, app_status, payment_config, blanko_config, dan cerdas_cermat_config)"
    },
    "/registrations/{registrationId}": {
      "schema": {
        "$ref": "#/entities/RegistrationSubmission"
      },
      "description": "Formulir pendaftaran digital 4 jenis kegiatan PKS"
    },
    "/cerdas_cermat_submissions/{submissionId}": {
      "schema": {
        "$ref": "#/entities/CerdasCermatSubmission"
      },
      "description": "Koleksi jawaban Lomba Cerdas Cermat per akun sekolah beserta penilaian Admin"
    }
  }
}
